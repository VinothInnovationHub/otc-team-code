# otc-team-code (App Service side) — complete environment variable reference.
#
# This is the ONLY place configuration should ever need to change. Every value
# this app reads comes from an environment variable (App Service Application
# Settings) — never a hardcoded URL, name, or key in code.
#
# NOTE: this app does NOT call generate_otc directly and does NOT need
# APIM_BASE_URL/APIM_SUBSCRIPTION_KEY — that call lives in the separate queue
# consumer (az-function-apps/otc-queue-consumer/.env.example).

# ---------------------------------------------------------------------------
# Bot Framework identity. Match whatever this team's own App Service bot
# already uses for these three (see their existing msbotservice deployment).
# ---------------------------------------------------------------------------
MicrosoftAppType=UserAssignedMSI
MicrosoftAppId=<this bot's app/client id>
MicrosoftAppTenantId=<this app's Entra tenant id>
AZURE_CLIENT_ID=<same as MicrosoftAppId, if using a user-assigned managed identity>

# Required by the microsoft-agents SDK's own MsalConnectionManager (SDK
# internal naming, not this project's) - same values as the three above.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<same as AZURE_CLIENT_ID>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<same as MicrosoftAppTenantId>

# ---------------------------------------------------------------------------
# Storage — business data (documents, tracking table, conversation refs,
# queue). REQUIRED.
# ---------------------------------------------------------------------------
STORAGE_ACCOUNT_NAME=
STORAGE_UPLOADS_CONTAINER=otc-uploads
STORAGE_GENERATED_CONTAINER=otc-generated
CONVERSATION_STORE_TABLE_NAME=ConversationReferences
TRACKING_TABLE_NAME=OtcRequestTracking
STORAGE_QUEUE_NAME=otc-request-queue
# Only set this if you want to auth storage via a connection string instead of
# the app's managed identity. Leave blank to use managed identity (recommended).
AZURE_STORAGE_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# This app's own base URL — used to build any self-referencing links.
# ---------------------------------------------------------------------------
APP_BASE_URL=https://<this-app-service>.azurewebsites.net

# Minutes a browser-upload SAS token stays valid for (frontend.py's direct
# PUT to Blob Storage). OPTIONAL - default is fine.
UPLOAD_SAS_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Storage toggle — true routes document storage/retrieval through SharePoint
# (Microsoft Graph), false (default) through Blob Storage. OPTIONAL.
# ---------------------------------------------------------------------------
USE_SHAREPOINT=false
# Required for the SharePoint tracking LIST (independent of USE_SHAREPOINT -
# see agent.py's _sharepoint_configured()) and, additionally, for document
# storage when USE_SHAREPOINT=true.
SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
# Raw Graph site ID ("host,siteGuid,webGuid") - distinct from SHAREPOINT_SITE_URL,
# needed for the Lists API. Get it via Graph: GET /sites/<host>:/sites/<site>
SHAREPOINT_SITE_ID=
# Display name of the SharePoint LIST (not the document library) that tracks
# requests. Auto-created with this name + a matching column set on first use.
SHAREPOINT_LIST_NAME=OTC Requests
# The document library's drive id. Get it via Graph: GET /sites/<siteId>/drive
SHAREPOINT_DRIVE_ID=

# Only needed if SharePoint lives in a DIFFERENT Entra tenant than this app
# (common when this bot's own tenant has no SharePoint/SPO license) - a
# managed identity cannot cross tenant boundaries, so a dedicated tenant-scoped
# app registration (Graph Sites.Selected, scoped to just this one site) is
# used instead. Leave all three blank if SharePoint is in the SAME tenant as
# this app - agent.py then just uses this app's own identity for Graph calls.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# App Service runtime. PORT is set automatically by App Service in production;
# the default below (3978) is just for local testing.
# ---------------------------------------------------------------------------
PORT=3978
