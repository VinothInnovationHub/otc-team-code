# otc-queue-consumer — complete environment variable reference.
#
# This is the ONLY place configuration should ever need to change for this
# Function App. Must stay in sync with the App Service app's own
# .env.example for every setting both sides share (STORAGE_ACCOUNT_NAME,
# USE_SHAREPOINT, the SHAREPOINT_* block) — they point at the same storage
# account and the same SharePoint site.

# ---------------------------------------------------------------------------
# APIM — the existing generate_otc (or equivalent) backend. REQUIRED.
# ---------------------------------------------------------------------------
APIM_BASE_URL=https://<your-apim-instance>.azure-api.net
# Secret. Get via Portal (APIM -> Subscriptions -> <subscription> -> Show/copy
# key) or `az rest ... listSecrets` yourself - never paste a real key into an
# AI assistant chat. Set directly as a Function App setting.
APIM_SUBSCRIPTION_KEY=

# ---------------------------------------------------------------------------
# Storage — business data. Must match the App Service app's STORAGE_ACCOUNT_NAME
# exactly — both sides read/write the SAME account. REQUIRED.
# ---------------------------------------------------------------------------
STORAGE_ACCOUNT_NAME=
STORAGE_UPLOADS_CONTAINER=otc-uploads
STORAGE_GENERATED_CONTAINER=otc-generated
CONVERSATION_STORE_TABLE_NAME=ConversationReferences
TRACKING_TABLE_NAME=OtcRequestTracking
AZURE_STORAGE_CONNECTION_STRING=

# The queue trigger binds through a SEPARATE identity-based connection,
# "StorageConnection" - see function_app.py's comment for the full reasoning.
# Must point at STORAGE_ACCOUNT_NAME above, NOT this Function App's own
# runtime storage account (AzureWebJobsStorage).
StorageConnection__accountName=
StorageConnection__credential=managedidentity
StorageConnection__clientId=
StorageConnection__queueServiceUri=https://<STORAGE_ACCOUNT_NAME>.queue.core.windows.net

# ---------------------------------------------------------------------------
# Storage toggle — must match the App Service app's USE_SHAREPOINT exactly.
# ---------------------------------------------------------------------------
USE_SHAREPOINT=false
SHAREPOINT_SITE_URL=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_NAME=OTC Requests
SHAREPOINT_DRIVE_ID=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Bot identity — only used for the proactive "your draft is ready" message
# (a raw Bot Connector REST call, no bot conversation handling in this app).
# Must match the App Service app's MicrosoftAppId / AZURE_CLIENT_ID.
# ---------------------------------------------------------------------------
MicrosoftAppId=
AZURE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Azure Functions runtime plumbing — standard, not project-specific.
# ---------------------------------------------------------------------------
FUNCTIONS_WORKER_RUNTIME=python
FUNCTIONS_EXTENSION_VERSION=~4
AzureWebJobsStorage=<connection string for this Function App's OWN runtime storage account - not STORAGE_ACCOUNT_NAME above>
APPLICATIONINSIGHTS_CONNECTION_STRING=<App Insights connection string for this app's telemetry>
